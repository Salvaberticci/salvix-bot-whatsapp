# --- CONFIGURACIÓN BASE DE DATOS (MYSQL) ---
# BD base: aloja el registro de clientes (tabla `tenants`) y funciona como
# panel general. Cada cliente tendrá su propia BD separada.
DB_HOST=localhost
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASS=tu_password

# --- WHATSAPP CLOUD API ---
# Token global (System User de la app con acceso a todas las WABAs de tus clientes).
WHATSAPP_API_TOKEN=tu_token_aqui
# Phone Number ID por defecto (modo monocliente). En modo multi-tenant cada
# cliente se resuelve por el phone_number_id del payload; este es solo el respaldo.
WHATSAPP_PHONE_NUMBER_ID=tu_id_aqui
VERIFY_TOKEN=salvix_token_2026

# --- INTELIGENCIA ARTIFICIAL (GROQ) ---
# Usamos Groq (https://api.groq.com/openai/v1). Las variables viejas OPENAI_*
# siguen funcionando como respaldo, pero se recomienda usar GROQ_*.
GROQ_API_KEY=tu_api_key_groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- CONFIGURACIÓN ADMIN (super admin / panel base) ---
ADMIN_USER=salvix_admin
ADMIN_PASSWORD=salvix_2026_secure

# Enlace CTA por defecto (modo monocliente). En modo multi-tenant cada cliente
# define su propio enlace en el panel (vista Clientes).
QUALIFIED_CTA_URL=https://tu-enlace-de-agendamiento.com